{
  "expo": {
    "name": "JurisAI",
    "slug": "jurisai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "jurisai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jurisai.app"
    },
    "android": {
      "package": "com.jurisai.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#0f172a"
        }
      ]
    ]
  }
}
